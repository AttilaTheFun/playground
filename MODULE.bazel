)

signing_tool_archive(
    name = "dmg_linux_x86_64",
    build_file_content = 'exports_files(["bin/dmg"])',
    sha256 = "67ee77b978b2b7b0875c9201bb9b09e5a5f716a49450bc53c804a7e2db4866b9",
    url = "https://github.com/apple-cross-toolchain/rules_applecross/releases/download/ported-tools-0.0.92/dmg-linux-x86_64.tar.zst",
